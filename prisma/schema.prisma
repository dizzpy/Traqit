generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── PROFILES ───────────────────────────────────────────────────────────────
model Profile {
  id                String             @id @default(cuid())
  userId            String             @unique // Supabase auth user UUID
  email             String             @unique
  name              String
  defaultCurrency   String             @default("LKR")
  defaultPipelineTemplateId String?    // pre-selected template in the Add form
  ghostThresholdDays Int               @default(14) // days of silence before a job reads as "ghosting"
  emailName         String?            // name used for the {myName} placeholder in email templates
  remindersEnabled  Boolean            @default(false) // email me before scheduled interviews
  reminderLeadTime  Int                @default(24) // hours before a scheduled stage to remind
  onboardedAt       DateTime?          // set when the guided onboarding flow is completed; null = not yet onboarded
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  applications      Application[]
  customSources     Source[]
  customTypes       JobType[]
  pipelineTemplates PipelineTemplate[]
  emailTemplates    EmailTemplate[]
  subscription      Subscription?
}

// ─── SUBSCRIPTION ────────────────────────────────────────────────────────────
// One-per-profile plan tier. Kept in its own table (not a column on Profile) so
// it can grow into a full subscription record later — billing provider id,
// period dates, status, etc. For now it only carries `plan`, defaulting to FREE.
model Subscription {
  id        String   @id @default(cuid())
  profileId String   @unique // 1:1 with Profile
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Plan {
  FREE
  PRO
  MAX
}

// ─── APPLICATIONS ────────────────────────────────────────────────────────────
model Application {
  id                String            @id @default(cuid())
  profileId         String
  profile           Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  companyName       String
  companyUrl        String?
  position          String
  jobPostUrl        String?

  jobType           String
  workMode          String
  appliedVia        String

  salaryMin         Float?
  salaryMax         Float?
  currency          String            @default("LKR")
  location          String?

  status            ApplicationStatus @default(SAVED)

  appliedDate       DateTime?
  firstResponseDate DateTime?
  deadline          DateTime?

  notes             String?

  stages            PipelineStage[]
  contacts          Contact[]
  documents         Document[]
  activityLog       Activity[]

  // Soft delete: non-null = in Trash. Lists filter on `deletedAt: null`; a
  // daily purge (pg_cron) + a lazy sweep hard-delete rows older than 30 days.
  deletedAt         DateTime?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([profileId])
  @@index([profileId, status])
  @@index([profileId, appliedDate])
  @@index([profileId, createdAt])
  @@index([profileId, deletedAt])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  IN_PROGRESS
  OFFER
  ACCEPTED
  REJECTED
  GHOSTED
  WITHDRAWN
}

// ─── PIPELINE STAGES ─────────────────────────────────────────────────────────
model PipelineStage {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name          String
  order         Int
  status        StageStatus @default(UPCOMING)
  scheduledDate DateTime?
  completedDate DateTime?
  notes         String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // No @@unique([applicationId, order]): shifting orders with an UPDATE …
  // increment trips Postgres's per-row unique check mid-statement, which was the
  // intermittent "couldn't add stage" 500. Order is just a sort key — lists sort
  // by (order, createdAt), so transient duplicates are harmless.
  @@index([applicationId])
  @@index([applicationId, order])
}

enum StageStatus {
  UPCOMING
  COMPLETED
  PASSED
  FAILED
  SKIPPED
}

// ─── CONTACTS ────────────────────────────────────────────────────────────────
model Contact {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name          String
  role          String
  email         String?
  phone         String?
  linkedinUrl   String?
  stageName     String?
  notes         String?

  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// ─── DOCUMENTS ───────────────────────────────────────────────────────────────
model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name          String
  url           String
  type          String

  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// ─── ACTIVITY LOG ────────────────────────────────────────────────────────────
model Activity {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type          String
  description   String
  metadata      Json?

  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([applicationId, createdAt])
}

// ─── CUSTOM PRESETS ──────────────────────────────────────────────────────────
model Source {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  usageCount Int      @default(0)

  @@unique([profileId, name])
}

model JobType {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  usageCount Int      @default(0)

  @@unique([profileId, name])
}

// ─── PIPELINE TEMPLATES ──────────────────────────────────────────────────────
model PipelineTemplate {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  stages    Json
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())

  @@unique([profileId, name])
}

// ─── EMAIL TEMPLATE ──────────────────────────────────────
model EmailTemplate {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  body      String
  category  String   @default("General")
  order     Int      @default(0)
  deletedAt DateTime? // soft delete — see Application.deletedAt
  createdAt DateTime @default(now())

  @@unique([profileId, name])
  @@index([profileId, deletedAt])
}
